{
  "name": "helena-video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "storybook build",
    "audit:lighthouse": "lighthouse http://127.0.0.1:4173/studio --output=html --output-path=./reports/lighthouse.html --chrome-flags=\"--headless=new\"",
    "qa": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "preview:local": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.75.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "lighthouse": "^12.8.2",
    "storybook": "^8.6.14",
    "typescript": "^5.6.2",
    "vite": "^6.4.2"
  }
