{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/studio",
      "permanent": false
    },
    {
      "source": "/r/:path*",
      "destination": "/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/studio",
      "destination": "/"
    },
    {
      "source": "/assets",
      "destination": "/"
    },
    {
      "source": "/audio",
      "destination": "/"
    },
    {
      "source": "/legendas",
      "destination": "/"
    },
    {
      "source": "/publicar",
      "destination": "/"
    },
    {
      "source": "/ajustes",
      "destination": "/"
    }
  ]
}
